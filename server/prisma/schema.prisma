generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String    @id @default(cuid())
  brand       String
  name        String
  slug        String    @unique
  description String
  category    String    @default("Smartphones")
  rating      Float     @default(4.5)
  reviewCount Int       @default(0)
  featured    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  variants    Variant[]
  @@index([brand])
}

model Variant {
  id           String    @id @default(cuid())
  productId    String
  storage      String
  color        String
  colorHex     String
  sku          String    @unique
  mrp          Int
  sellingPrice Int
  image        String
  images       String[]
  inStock      Boolean   @default(true)
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  emiPlans     EmiPlan[]
  @@index([productId])
}

model EmiPlan {
  id          String   @id @default(cuid())
  variantId   String
  provider    String
  tenure      Int
  interestRate Float
  monthlyEmi  Int
  cashback    Int      @default(0)
  processingFee Int    @default(0)
  popular     Boolean  @default(false)
  variant     Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  @@index([variantId])
}
